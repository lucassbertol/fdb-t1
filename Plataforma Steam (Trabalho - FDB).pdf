/Title (SELECT        g.name AS genero,       COUNT\(DISTINCT gam.app_id\) AS total_jogos,       ROUND\(AVG\(gam.price\), 2\) AS preco_medio,       SUM\(gam.price * gam.estimated_owners_min\) AS receita_minima_estimada FROM genres g JOIN game_genres gg ON g.genre_id = gg.genre_id JOIN games gam ON gg.app_id = gam.app_id JOIN game_developers gd ON gam.app_id = gd.app_id GROUP BY g.genre_id, g.name HAVING COUNT\(DISTINCT gam.app_id\) >= 5 ORDER BY receita_minima_estimada DESC LIMIT 10;)
/Dest [23 0 R /Fit]
/Parent 1019 0 R
>>
endobj
